              "raw": "{\n  \"UserPoolId\": \"C_jiCgTjeDxd\",\n  \"Username\": \"N\",\n  \"MFAOptions\": [\n    {\n      \"DeliveryMedium\": \"SMS\",\n      \"AttributeName\": \"{ppPSLS\"\n    },\n    {\n      \"DeliveryMedium\": \"EMAIL\",\n      \"AttributeName\": \"pL{{LMML\"\n    }\n  ]\n}",
