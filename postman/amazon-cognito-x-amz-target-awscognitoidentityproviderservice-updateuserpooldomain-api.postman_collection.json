              "raw": "{\n  \"Domain\": \"026e68fj2zg9cei1vlp7t-5odlfclci-9qazaiz4ktp5hzf1xxu1r3voeaghit\",\n  \"UserPoolId\": \"9LDnbux_2pANevJ7\",\n  \"CustomDomainConfig\": {\n    \"CertificateArn\": \"arn:LmPxukwhaWJ:1XwKdJ/CBJI:-:4728:0w:JrLpb5pd:FJqA7+TJ/\"\n  }\n}",
