              "raw": "{\n  \"UserPoolId\": \"JQY_rR3ShLB\",\n  \"SmsMfaConfiguration\": {\n    \"SmsAuthenticationMessage\": \"}6!_r4(<|{####}zIJ\",\n    \"SmsConfiguration\": {\n      \"SnsCallerArn\": \"arn:qbnAuNhbS:NsjKe@j::43655436079:vccnXX:4,a:s6BlRJN\",\n      \"ExternalId\": \"<string>\",\n      \"SnsRegion\": \"<string>\"\n    }\n  },\n  \"SoftwareTokenMfaConfiguration\": {\n    \"Enabled\": \"<boolean>\"\n  },\n  \"MfaConfiguration\": \"ON\"\n}",
