              "raw": "{\n  \"IdentityId\": \"m:1a7217\",\n  \"IdentityPoolId\": \"w:ae\",\n  \"DeveloperProviderName\": \"ZrjukoBPv1\",\n  \"DeveloperUserIdentifier\": \"<string>\"\n}",
