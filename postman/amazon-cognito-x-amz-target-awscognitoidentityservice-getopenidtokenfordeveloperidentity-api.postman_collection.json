              "raw": "{\n  \"IdentityPoolId\": \"-H:0d3\",\n  \"Logins\": {\n    \"esse_c0\": \"<string>\",\n    \"ad_ae\": \"<string>\",\n    \"occaecat_7\": \"<string>\"\n  },\n  \"IdentityId\": \"mIvOe:14d\",\n  \"PrincipalTags\": {\n    \"do_e74\": \"<string>\",\n    \"ina4\": \"<string>\",\n    \"nostrud8\": \"<string>\",\n    \"eiusmodd0c\": \"<string>\",\n    \"pariatur__08\": \"<string>\",\n    \"velit_c6\": \"<string>\",\n    \"nostrud_b9\": \"<string>\",\n    \"cillum_e1\": \"<string>\",\n    \"mollit18f\": \"<string>\",\n    \"voluptate54\": \"<string>\",\n    \"qui89e\": \"<string>\"\n  },\n  \"TokenDuration\": \"<integer>\"\n}",
