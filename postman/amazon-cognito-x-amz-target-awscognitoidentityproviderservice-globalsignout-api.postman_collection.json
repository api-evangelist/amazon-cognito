      "name": "#X-Amz-Target=AWSCognitoIdentityProviderService.GlobalSignOut",
      "item": [
        {
          "name": "Amazon Cognito Global Sign Out",
          "id": "da8c3ffe-5c03-4d93-a764-b4a91e40e12f",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
